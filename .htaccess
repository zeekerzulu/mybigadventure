  # === Block aggressive / AI crawlers (403) — backstop for robots.txt ===
  # Googlebot/Bingbot intentionally NOT listed, so search still works.
  SetEnvIfNoCase User-Agent "(ClaudeBot|anthropic-ai|Claude-Web|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|CCBot|Bytespider|Amazonbot|Meta-Ext
  ernalAgent|FacebookBot|Diffbot|ImagesiftBot|PetalBot|AhrefsBot|SemrushBot|DataForSeoBot|MJ12bot|DotBot)" bad_bot


  # Begin cache control #
  ExpiresActive on
  <FilesMatch "\.(ico|bmp|gff|gif|gcf|jpg|png|jpeg)$">
  FileETag MTime Size
  ExpiresDefault "now plus 1440 minutes"
  </FilesMatch>
  # End cache control #

  
  # compress text, html, javascript, css, xml:
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/dat
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript

  Order Allow,Deny
  Allow from all
  Deny from env=bad_bot
